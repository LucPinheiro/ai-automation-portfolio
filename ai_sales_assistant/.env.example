# Application
APP_NAME=AI Sales Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (Version 1: SQLite; Version 2: PostgreSQL URL)
DATABASE_URL=sqlite:///./ai_sales_assistant.db

# AI provider: "openai" (OpenAI API) or "ollama" (local Ollama server)
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
# Put your real key only in .env (git-ignored). Never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200

# Ollama (used when AI_PROVIDER=ollama; no API key needed)
# Inside Docker, localhost is the container: docker-compose.yml overrides this with
# http://host.docker.internal:11434 (Ollama on the host machine).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_OUTPUT_TOKENS=1200

# Authentication (server-side sessions in an HttpOnly cookie)
SESSION_COOKIE_NAME=ai_sales_session
SESSION_TTL_HOURS=168
# Leave empty for the default: Secure cookie only when ENVIRONMENT=production (needs HTTPS)
SESSION_COOKIE_SECURE=
PASSWORD_RESET_TTL_MINUTES=30
# Public URL of the app: used in password reset links and as a trusted origin (CSRF check)
APP_BASE_URL=http://127.0.0.1:8000

# Email: "console" writes emails (and reset links) to the server log - development only.
# "smtp" sends them; ENVIRONMENT=production requires smtp.
EMAIL_BACKEND=console
EMAIL_FROM=AI Sales Assistant <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Guest mode ("Entrar sin iniciar sesión"): temporary accounts deleted on logout/expiry
GUEST_MODE_ENABLED=true
GUEST_SESSION_TTL_HOURS=24
# Maximum AI generations (including regenerations) per guest: protects OpenAI costs
GUEST_MAX_GENERATIONS=10

# Demo access: these public credentials open a guest session (they are not an account).
# Requires GUEST_MODE_ENABLED=true. Set DEMO_LOGIN_ENABLED=false outside a demo.
DEMO_LOGIN_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# Mandatory commercial terms (prices, discounts, scales written in "Necesidades del cliente"):
# after generating, the app checks that every term is in the text and asks the model again
# up to COMMERCIAL_TERMS_MAX_RETRIES times (0-3). If still missing, the text is saved with a
# visible warning; with COMMERCIAL_TERMS_STRICT=true it is rejected (502) instead.
COMMERCIAL_TERMS_MAX_RETRIES=1
COMMERCIAL_TERMS_STRICT=false

# Support details on /contacto. DEMO VALUES: replace them with the real ones and set
# SUPPORT_CONTACT_IS_DEMO=false. Leave the email or phone empty to hide it.
SUPPORT_EMAIL=soporte@aisalesassistant.demo
SUPPORT_PHONE=+34 600 123 456
SUPPORT_HOURS_OPEN=09:00
SUPPORT_HOURS_CLOSE=18:00
SUPPORT_CONTACT_IS_DEMO=true
# Footer buttons on every screen: "Correo electrónico" (SUPPORT_EMAIL), "WhatsApp" (SUPPORT_PHONE,
# opened with wa.me) and "GitHub" (this URL). An empty value hides its button.
GITHUB_URL=https://github.com/LucPinheiro
# Contact form: only "demo" for now (validates, sends and stores nothing)
CONTACT_FORM_MODE=demo
