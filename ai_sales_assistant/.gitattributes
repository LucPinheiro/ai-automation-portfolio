# Line endings: LF in the repository and in the working copy, on every platform.
# Overrides each developer's core.autocrlf, so Git no longer warns about LF/CRLF conversions.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never converted or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.db binary
*.sqlite binary
